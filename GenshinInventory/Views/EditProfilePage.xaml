<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GenshinInventory.Views.EditProfilePage"
             Title="Edit Profile">
    <Grid ColumnDefinitions="220,*">
        <VerticalStackLayout Grid.Column="0"
                             BackgroundColor="#2F49A8"
                             Padding="20,40"
                             Spacing="25">

            <Label Text="COMPUTER SHOP&#10;INVENTORY"
                   TextColor="White"
                   FontSize="24"
                   FontAttributes="Bold" />

            <Button Text="Stocks"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    Clicked="OnStocksClicked" />

            <Button Text="Profile"
                    BackgroundColor="#D9D9D9"
                    TextColor="#2F49A8"
                    CornerRadius="0"
                    Clicked="OnProfileClicked" />

            <Button Text="Log Out"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    Clicked="OnLogoutClicked" />
        </VerticalStackLayout>
        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="40,35" Spacing="18">

                <Label Text="Edit Profile"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="#2F49A8" />

                <Frame BackgroundColor="#D9D1C4"
                       CornerRadius="20"
                       Padding="25"
                       HasShadow="False">

                    <VerticalStackLayout Spacing="14">

                        <Label Text="Full Name" TextColor="#2F49A8" FontAttributes="Bold" />
                        <Entry x:Name="FullNameEntry"
                               Placeholder="Enter full name"
                               TextColor="Black"
                               BackgroundColor="White" />

                        <Label Text="Username" TextColor="#2F49A8" FontAttributes="Bold" />
                        <Entry x:Name="UsernameEntry"
                               Placeholder="Enter username"
                               TextColor="Black"
                               BackgroundColor="White" />

                        <Label Text="Email" TextColor="#2F49A8" FontAttributes="Bold" />
                        <Entry x:Name="EmailEntry"
                               Placeholder="Enter email"
                               TextColor="Black"
                               BackgroundColor="White" />

                        <HorizontalStackLayout Spacing="12" Margin="0,10,0,0">
                            <Button Text="Save Changes"
                                    BackgroundColor="#2F49A8"
                                    TextColor="White"
                                    Clicked="OnSaveChangesClicked" />

                            <Button Text="Cancel"
                                    BackgroundColor="Gray"
                                    TextColor="White"
                                    Clicked="OnCancelClicked" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
        </Grid>
</ContentPage>